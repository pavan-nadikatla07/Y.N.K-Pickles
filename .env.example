# ===================================================================
# Y.N.K Pickles - Master Environment Variables Template
# ===================================================================
# Note: Treat all credentials as secrets. Never commit actual connection
# strings, passwords, or API keys to version control.
# ===================================================================

# Server Runtime Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# Format for MongoDB Atlas Cluster0:
# mongodb+srv://<username>:<password>@cluster0.<unique-id>.mongodb.net/ynk_pickles?retryWrites=true&w=majority
# Format for Local MongoDB:
# mongodb://127.0.0.1:27017/ynk_pickles
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.<subdomain>.mongodb.net/ynk_pickles?retryWrites=true&w=majority
DB_NAME=ynk_pickles

# JWT & Session Encryption Key (Minimum 32 random characters)
SESSION_SECRET=replace_with_a_secure_long_random_secret_at_least_32_characters

# CORS Settings - Allowed Client Web Application URL
CLIENT_URL=http://localhost:5173

# Initial Administrator Seed Configuration (Used by npm run seed:admin)
INITIAL_ADMIN_NAME=Admin YNK
INITIAL_ADMIN_PHONE=919876543210
INITIAL_ADMIN_EMAIL=admin@ynkpickles.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_password

# Default WhatsApp Business Recipient Number (Digits only with country code, e.g., 919876543210)
DEFAULT_WHATSAPP_NUMBER=919876543210

# Server-Side Google Maps API Key (Optional - for Google Routes API road distance; falls back automatically to high-precision driving routing if unconfigured)
GOOGLE_MAPS_API_KEY=
